<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.Authentication.Views.ChangePasswordPage"
             Title="{Binding Title}" BackgroundColor="#F4F6F9">
    <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="400">
        <Border BackgroundColor="White" Padding="25" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <VerticalStackLayout Spacing="15">
                <Label Text="Update Your Password" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,10"/>

                <Entry Placeholder="Current Password" Text="{Binding OldPassword}" IsPassword="True" BackgroundColor="#F8FAFC" HeightRequest="50"/>
                <Entry Placeholder="New Password" Text="{Binding NewPassword}" IsPassword="True" BackgroundColor="#F8FAFC" HeightRequest="50" Margin="0,10,0,0"/>
                <Entry Placeholder="Confirm New Password" Text="{Binding ConfirmPassword}" IsPassword="True" BackgroundColor="#F8FAFC" HeightRequest="50"/>

                <Button Text="Update Password" Command="{Binding ChangePasswordCommand}" BackgroundColor="#10B981" TextColor="White" HeightRequest="50" FontAttributes="Bold" Margin="0,15,0,0"/>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#10B981"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>