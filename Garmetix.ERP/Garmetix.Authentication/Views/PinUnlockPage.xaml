<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.Authentication.Views.PinUnlockPage"
             Shell.NavBarIsVisible="False" BackgroundColor="#0F172A">
    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="30">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                <Label Text="GARMETIX ERP" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" HorizontalOptions="Center" CharacterSpacing="2"/>
                <Label Text="{Binding Message}" FontSize="14" TextColor="{Binding MessageColor}" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,10,0,30">
                <Ellipse Fill="{Binding Dot1, Converter={StaticResource BoolToColorConverter}}" WidthRequest="16" HeightRequest="16" />
                <Ellipse Fill="{Binding Dot2, Converter={StaticResource BoolToColorConverter}}" WidthRequest="16" HeightRequest="16" />
                <Ellipse Fill="{Binding Dot3, Converter={StaticResource BoolToColorConverter}}" WidthRequest="16" HeightRequest="16" />
                <Ellipse Fill="{Binding Dot4, Converter={StaticResource BoolToColorConverter}}" WidthRequest="16" HeightRequest="16" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="80,80,80" RowDefinitions="80,80,80,80" ColumnSpacing="20" RowSpacing="20" HorizontalOptions="Center">
                <Button Grid.Row="0" Grid.Column="0" Text="1" Command="{Binding KeypressCommand}" CommandParameter="1" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="0" Grid.Column="1" Text="2" Command="{Binding KeypressCommand}" CommandParameter="2" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="0" Grid.Column="2" Text="3" Command="{Binding KeypressCommand}" CommandParameter="3" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="1" Grid.Column="0" Text="4" Command="{Binding KeypressCommand}" CommandParameter="4" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="1" Grid.Column="1" Text="5" Command="{Binding KeypressCommand}" CommandParameter="5" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="1" Grid.Column="2" Text="6" Command="{Binding KeypressCommand}" CommandParameter="6" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="2" Grid.Column="0" Text="7" Command="{Binding KeypressCommand}" CommandParameter="7" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="2" Grid.Column="1" Text="8" Command="{Binding KeypressCommand}" CommandParameter="8" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="2" Grid.Column="2" Text="9" Command="{Binding KeypressCommand}" CommandParameter="9" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="3" Grid.Column="1" Text="0" Command="{Binding KeypressCommand}" CommandParameter="0" BackgroundColor="#1E293B" TextColor="White" FontSize="28" CornerRadius="40"/>
                <Button Grid.Row="3" Grid.Column="2" Text="⌫" Command="{Binding KeypressCommand}" CommandParameter="DEL" BackgroundColor="Transparent" TextColor="#94A3B8" FontSize="28"/>
            </Grid>

            <Button Text="Logout / Switch User" Command="{Binding SwitchUserCommand}" BackgroundColor="Transparent" TextColor="#38BDF8" FontAttributes="Bold" Margin="0,30,0,0"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>