<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.Authentication.Views.ResetPasswordPage"
             Title="{Binding Title}" BackgroundColor="#F4F6F9">
    <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="400">
        <Border BackgroundColor="White" Padding="25" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <VerticalStackLayout Spacing="15">
                <Label Text="Override Staff Password" FontSize="18" FontAttributes="Bold" TextColor="#EF4444" Margin="0,0,0,10"/>

                <Entry Placeholder="Target Staff Username" Text="{Binding TargetUsername}" BackgroundColor="#F8FAFC" HeightRequest="50"/>
                <Entry Placeholder="New Temporary Password" Text="{Binding NewPassword}" IsPassword="True" BackgroundColor="#F8FAFC" HeightRequest="50"/>

                <Button Text="Force Reset" Command="{Binding ResetPasswordCommand}" BackgroundColor="#EF4444" TextColor="White" HeightRequest="50" FontAttributes="Bold" Margin="0,15,0,0"/>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#EF4444"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>