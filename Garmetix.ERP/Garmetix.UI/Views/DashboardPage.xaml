<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Garmetix.UI.Views.DashboardPage"
             Title="{Binding Title}" BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            
            <Label Text="BUSINESS OVERVIEW" FontSize="14" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15">
                
                <Border Grid.Column="0" BackgroundColor="#0F172A" Padding="20" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="TODAY'S COLLECTIONS" FontSize="11" TextColor="#94A3B8" FontAttributes="Bold"/>
                        <Label Text="{Binding TodaysCollections, StringFormat='₹ {0:N2}'}" FontSize="24" TextColor="#10B981" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#0F172A" Padding="20" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="TODAY'S EXPENSES" FontSize="11" TextColor="#94A3B8" FontAttributes="Bold"/>
                        <Label Text="{Binding TodaysExpenses, StringFormat='₹ {0:N2}'}" FontSize="24" TextColor="#EF4444" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="#D4AF37" Padding="20" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="CASH IN BANK" FontSize="11" TextColor="#0F172A" FontAttributes="Bold"/>
                        <Label Text="{Binding TotalBankBalance, StringFormat='₹ {0:N2}'}" FontSize="24" TextColor="#0F172A" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Label Text="QUICK ACTIONS" FontSize="14" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="120, 120" ColumnSpacing="15" RowSpacing="15">
                
                <Button Grid.Row="0" Grid.Column="0" Text="💳 New Voucher" Command="{Binding QuickActionCommand}" CommandParameter="VoucherEntryPage"
                        BackgroundColor="White" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" CornerRadius="12">
                    <Button.Shadow><Shadow Brush="#0F172A" Offset="0,4" Radius="8" Opacity="0.1" /></Button.Shadow>
                </Button>

                <Button Grid.Row="0" Grid.Column="1" Text="👥 Add New Party" Command="{Binding QuickActionCommand}" CommandParameter="DynamicEntryPage?EntityType=Party"
                        BackgroundColor="White" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" CornerRadius="12">
                    <Button.Shadow><Shadow Brush="#0F172A" Offset="0,4" Radius="8" Opacity="0.1" /></Button.Shadow>
                </Button>

                <Button Grid.Row="1" Grid.Column="0" Text="🏦 Add Bank Account" Command="{Binding QuickActionCommand}" CommandParameter="DynamicEntryPage?EntityType=BankAccount"
                        BackgroundColor="White" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" CornerRadius="12">
                    <Button.Shadow><Shadow Brush="#0F172A" Offset="0,4" Radius="8" Opacity="0.1" /></Button.Shadow>
                </Button>
                
                <Button Grid.Row="1" Grid.Column="1" Text="🛒 Point of Sale" BackgroundColor="#0F172A" TextColor="#D4AF37" FontSize="16" FontAttributes="Bold" CornerRadius="12" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>