<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="Garmetix.UI.Views.Accounting.VoucherEntryPage"
             Title="{Binding Title}" BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Border BackgroundColor="#0F172A" Padding="25" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <VerticalStackLayout Spacing="15">
                    <Label Text="VOUCHER DETAILS" FontSize="14" FontAttributes="Bold" TextColor="#D4AF37" CharacterSpacing="2"/>
                    
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="Voucher Type" ContainerType="Outlined" BackgroundColor="White">
                            <inputs:SfComboBox ItemsSource="{Binding VoucherTypes}" SelectedItem="{Binding CurrentVoucher.VoucherType}" />
                        </core:SfTextInputLayout>
                        
                        <core:SfTextInputLayout Hint="Voucher Number" ContainerType="Outlined" BackgroundColor="White">
                            <Entry Text="{Binding CurrentVoucher.VoucherNumber}" IsReadOnly="True" FontAttributes="Bold" TextColor="#0F172A"/>
                        </core:SfTextInputLayout>
                        
                        <core:SfTextInputLayout Hint="Date" ContainerType="Outlined" BackgroundColor="White">
                            <DatePicker Date="{Binding CurrentVoucher.OnDate}" />
                        </core:SfTextInputLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Padding="25" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="#0F172A" Offset="0,4" Radius="12" Opacity="0.1" /></Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    
                    <core:SfTextInputLayout Hint="Party / Ledger Account" ContainerType="Outlined">
                        <inputs:SfAutocomplete ItemsSource="{Binding AvailableParties}" DisplayMemberPath="Name" TextMemberPath="Name"
                                               Text="{Binding CurrentVoucher.PartyName, Mode=TwoWay}" FontAttributes="Bold"/>
                    </core:SfTextInputLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                        <core:SfTextInputLayout Hint="Amount (₹)" ContainerType="Outlined">
                            <Entry Text="{Binding CurrentVoucher.Amount}" Keyboard="Numeric" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                        </core:SfTextInputLayout>
                        
                        <core:SfTextInputLayout Hint="Payment Mode" ContainerType="Outlined">
                            <inputs:SfComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedPaymentMode}" />
                        </core:SfTextInputLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="20" IsVisible="{Binding IsBankMode}">
                        <core:SfTextInputLayout Hint="Company Bank Account" ContainerType="Outlined">
                            <inputs:SfComboBox ItemsSource="{Binding AvailableBanks}" DisplayMemberPath="AccountNumber" SelectedItem="{Binding SelectedBank}" />
                        </core:SfTextInputLayout>
                        <core:SfTextInputLayout Hint="Instrument No / Ref Details" ContainerType="Outlined">
                            <Entry Text="{Binding CurrentVoucher.PaymentDetails}" />
                        </core:SfTextInputLayout>
                    </Grid>

                    <core:SfTextInputLayout Hint="Particulars / Narration" ContainerType="Outlined">
                        <Editor Text="{Binding CurrentVoucher.Particulars}" HeightRequest="80" />
                    </core:SfTextInputLayout>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="15" Margin="0,10,0,30">
                <Button Text="Save Securely" Command="{Binding SaveCommand}" BackgroundColor="#D4AF37" TextColor="#0F172A" WidthRequest="200" HeightRequest="50" FontAttributes="Bold"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>