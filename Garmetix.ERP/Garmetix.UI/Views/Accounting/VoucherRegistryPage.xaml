        <Border Grid.Row="1" Margin="20,10,20,20" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <Grid>
                <sfgrid:SfDataGrid ItemsSource="{Binding FilteredVouchers}" AllowGrouping="True" AutoGenerateColumnsMode="None" HeaderRowHeight="50" RowHeight="55">
                    <sfgrid:SfDataGrid.GroupColumnDescriptions>
                        <sfgrid:GroupColumnDescription ColumnName="VoucherType" />
                    </sfgrid:SfDataGrid.GroupColumnDescriptions>

                    <sfgrid:SfDataGrid.Columns>
                        <sfgrid:DataGridDateColumn MappingName="OnDate" HeaderText="Date" Format="dd-MMM-yyyy" Width="120"/>

                        <sfgrid:DataGridTemplateColumn MappingName="VoucherNumber" HeaderText="Voucher No" Width="150">
                            <sfgrid:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding VoucherNumber}" 
                                   FontAttributes="Bold" 
                                   VerticalTextAlignment="Center" 
                                   Padding="10,0"/>
                                </DataTemplate>
                            </sfgrid:DataGridTemplateColumn.CellTemplate>
                        </sfgrid:DataGridTemplateColumn>

                        <sfgrid:DataGridTextColumn MappingName="PartyName" HeaderText="Party / Ledger Name" />
                        <sfgrid:DataGridNumericColumn MappingName="Amount" HeaderText="Amount (₹)" Format="N2" />

                        <sfgrid:DataGridTemplateColumn HeaderText="Actions" Width="100">
                            <sfgrid:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Text="Options" BackgroundColor="#D4AF37" TextColor="#0F172A" CornerRadius="6" HeightRequest="35" FontAttributes="Bold"
                                    Command="{Binding BindingContext.ActionMenuCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}"/>
                                </DataTemplate>
                            </sfgrid:DataGridTemplateColumn.CellTemplate>
                        </sfgrid:DataGridTemplateColumn>
                    </sfgrid:SfDataGrid.Columns>
                </sfgrid:SfDataGrid>
            </Grid>
        </Border>
        <Button Grid.Row="1" Command="{Binding AddNewVoucherCommand}" Text="+" FontSize="32" FontAttributes="Bold" TextColor="#0F172A"
                BackgroundColor="#D4AF37" CornerRadius="30" WidthRequest="60" HeightRequest="60" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,30,40">
            <Button.Shadow><Shadow Brush="#D4AF37" Offset="0,4" Radius="10" Opacity="0.5" /></Button.Shadow>
        </Button>
    </Grid>
</ContentPage>