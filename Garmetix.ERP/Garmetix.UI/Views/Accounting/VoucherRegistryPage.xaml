             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             x:Class="Garmetix.UI.Views.Accounting.VoucherRegistryPage"
             Title="{Binding Title}" BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Margin="20,20,20,10" BackgroundColor="#0F172A" Padding="15" StrokeShape="RoundRectangle 12" StrokeThickness="0">
            <core:SfTextInputLayout Hint="🔍 Search Voucher No or Party Name" ContainerType="Outlined" HintLabelStyle="{core:LabelStyle TextColor=#94A3B8}">
                <Entry Text="{Binding SearchText, Mode=TwoWay}" TextColor="White" ClearButtonVisibility="WhileEditing" />
            </core:SfTextInputLayout>
        </Border>

