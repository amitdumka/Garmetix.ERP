<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dataForm="clr-namespace:Syncfusion.Maui.DataForm;assembly=Syncfusion.Maui.DataForm"
             x:Class="Garmetix.UI.Views.DynamicEntryPage"
             Title="{Binding Title}" BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Border BackgroundColor="White" Padding="25" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="#0F172A" Offset="0,4" Radius="12" Opacity="0.1" /></Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="RECORD DETAILS" FontSize="14" FontAttributes="Bold" TextColor="#D4AF37" CharacterSpacing="2" Margin="0,0,0,10"/>
                    
                    <dataForm:SfDataForm DataObject="{Binding CurrentEntity}" 
                                         LayoutType="Default" 
                                         ValidationMode="PropertyChanged"
                                         IsReadOnly="False">
                        </dataForm:SfDataForm>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="15" Margin="0,10,0,30">
                <Button Text="Cancel" Command="{Binding CancelCommand}" BackgroundColor="#E2E8F0" TextColor="#475569" WidthRequest="120" HeightRequest="50" FontAttributes="Bold"/>
                <Button Text="Save Securely" Command="{Binding SaveCommand}" BackgroundColor="#0F172A" TextColor="#D4AF37" WidthRequest="200" HeightRequest="50" FontAttributes="Bold">
                    <Button.Shadow><Shadow Brush="#0F172A" Offset="0,4" Radius="8" Opacity="0.3" /></Button.Shadow>
                </Button>
            </HorizontalStackLayout>
            
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#D4AF37"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>